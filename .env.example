# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o Git.
# Tudo é opcional: sem credenciais, o Replique roda em modo demonstração.

# Endereço público do Replique (quando for hospedado num domínio real).
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Chave que protege sessões e credenciais. Se ficar vazia, é gerada em data/secret.key.
SECRET_KEY=

# --- IA (opcional) — https://console.anthropic.com > API Keys ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Mercado Livre — https://developers.mercadolivre.com.br/devcenter ---
# Um aplicativo só, para o Replique inteiro. Cada empresa cliente conecta a
# própria conta de vendedor pela tela Contas.
# Permissões do app: "Publicação e sincronização" = Leitura e escrita.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# O ML não aceita "localhost". Local: callback do Postman (mostra o código
# para colar). Em produção: https://SEU-DOMINIO/api/contas/mercadolivre/callback
ML_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
ML_SITE_ID=MLB

# --- Shopee Open Platform (publicar) — https://open.shopee.com ---
# A pesquisa de mais vendidos usa a API de Afiliados, configurada por empresa na tela Contas.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_HOST=https://partner.shopeemobile.com
SHOPEE_REDIRECT_URI=https://oauth.pstmn.io/v1/callback

# --- Amazon SP-API — Seller Central > Aplicativos e serviços > Desenvolver aplicativos ---
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_ENDPOINT=https://sellingpartnerapi-na.amazon.com
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC

# --- Hospedagem ---
# Como o Replique descobre o IP real de quem acessa (limite de tentativas de login):
#   cloudflare = Cloudflare Tunnel / Cloudflare na frente (padrão; é o que o publicar-teste.bat usa)
#   xff        = proxy reverso (Nginx, Render, Railway). Informe em PROXY_IPS o IP/rede do proxy
#   nenhum     = servidor exposto direto, sem proxy
PROXY_MODO=cloudflare
PROXY_IPS=127.0.0.1,::1
# Para criar o primeiro administrador num servidor: python criar_admin.py

# --- Gerador de fotos com IA (opcional) ---
# Preencha UMA das chaves. Sem chave, o gerador faz só o fundo branco (quando a
# foto já tem fundo liso) e a foto de características.
IMAGENS_PROVEDOR=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Margem e radar de preço (confira as tarifas da sua categoria) ---
SHOPEE_COMISSAO_PCT=20
SHOPEE_TAXA_FIXA=4
AMAZON_COMISSAO_PCT=13
IMPOSTO_PCT_PADRAO=6
MARGEM_MINIMA_PCT=10

# --- Entrar com Google (opcional) ---
# console.cloud.google.com › APIs e serviços › Credenciais › Criar ID do cliente OAuth › Aplicativo da Web.
# Em "URIs de redirecionamento autorizados" coloque: {PUBLIC_BASE_URL}/api/auth/google/callback
# (no computador: http://127.0.0.1:8000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail dos convites da equipe (opcional; sem isto o link aparece para copiar) ---
# Gmail: use uma "senha de app" (Conta Google › Segurança › Senhas de app), não a senha normal.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=
CONVITE_DIAS=7
